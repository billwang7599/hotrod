{
  "name": "hotrod",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=26" },
  "scripts": {
    "dev": "npm run dev -w @hotrod/core & npm run dev -w @hotrod/ui & wait",
    "typecheck": "tsc -p packages/core && tsc -p packages/ui",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
