{
  "manifest_version": 3,
  "name": "Kothar",
  "version": "1.0.0",
  "description": "Lets Kothar's agents browse in your Chrome, only in each space's blue Kothar tab group.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["tabs", "tabGroups", "debugger", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Kothar", "default_popup": "popup.html" }
}
