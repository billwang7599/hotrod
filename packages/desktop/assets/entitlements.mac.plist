<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the hardened runtime, used only when Kothar is signed with a Developer ID (see
     electron-builder.config.cjs). Electron's V8 needs JIT and writable-executable memory. The core also runs this binary
     as Node (ELECTRON_RUN_AS_NODE) for the Browser mod's scripts, which inherit these. Engines and sandbox-exec are
     separate programs with their own signatures, so nothing here limits them. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
